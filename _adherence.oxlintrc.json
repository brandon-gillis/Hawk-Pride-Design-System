        "selector": "JSXOpeningElement[name.name='TrailRow'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:easy|moderate|difficult|extreme)$/]",
        "message": "<TrailRow> level must be one of 'easy' | 'moderate' | 'difficult' | 'extreme'."

      {
        "selector": "JSXOpeningElement[name.name='TrailRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:open|closed)$/]",
        "message": "<TrailRow> status must be one of 'open' | 'closed'."
      }

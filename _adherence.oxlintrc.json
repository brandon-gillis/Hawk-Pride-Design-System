        "selector": "JSXOpeningElement[name.name='TrailRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|name|level|vehicles|length|status|onClick|key|ref|className|style|children)$/]",
        "message": "<TrailRow> doesn't accept that prop. Declared props: number, name, level, vehicles, length, status, onClick."
